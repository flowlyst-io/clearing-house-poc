# Copy to .env.local and fill in. .env.local is gitignored — secrets never ship to the client.
ANTHROPIC_API_KEY=sk-ant-...

# Neon Postgres connection string (use the POOLED URL from the Neon dashboard).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
