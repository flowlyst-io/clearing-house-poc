# Copy to .env.local and fill in. .env.local is gitignored — secrets never ship to the client.
ANTHROPIC_API_KEY=sk-ant-...

# Neon Postgres connection string (use the POOLED URL from the Neon dashboard).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# LLM provider for /api/parse and /api/summarize. "anthropic" (default) uses the
# Anthropic SDK directly; "openrouter" routes both calls through OpenRouter's
# auto-router (openrouter/auto). Flip this to A/B test without other changes.
LLM_PROVIDER=anthropic

# Required only when LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=sk-or-...
# Optional overrides for the OpenRouter path:
# OPENROUTER_MODEL=openrouter/auto        # pin a specific model instead of auto
# OPENROUTER_SITE_URL=http://localhost:3000  # sent as HTTP-Referer for OpenRouter rankings
